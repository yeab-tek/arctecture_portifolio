# Copy this file to .env and fill in real values before running in production.

# Swap to a Postgres URL for production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/architect_portfolio
DATABASE_URL=sqlite:///./app.db

# Generate a real secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Initial admin account created by seed.py (change the password immediately after first login)
ADMIN_EMAIL=architect@example.com
ADMIN_PASSWORD=change-me-please

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UPLOAD_DIR=uploads
